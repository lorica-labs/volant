# A systemd host for the corpus runs. The run's public key is added when a container starts, so
# the image carries no key. The apt lists stay, so roles can install packages.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server python3 python3-apt sudo acl ca-certificates gnupg locales \
 && locale-gen en_US.UTF-8 \
 && systemctl enable ssh \
 && useradd -m -s /bin/bash corpus \
 && echo 'corpus ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/corpus \
 && chmod 440 /etc/sudoers.d/corpus
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
