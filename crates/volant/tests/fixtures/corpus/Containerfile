# A systemd host for the corpus runs. The run's public key is added when a container starts, so
# the image carries no key. The apt lists stay, so roles can install packages; iproute2 gives the
# network facts (`ansible_default_ipv4`) something to read and rsyslog the `syslog` group some hardening roles use.
FROM ubuntu:26.04@sha256:0e73b71479e7bc5f006bca872e25c3cd680dc052a0116f90d63ae363537db0dd
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server python3 python3-apt sudo acl ca-certificates gnupg locales iproute2 rsyslog \
 && locale-gen en_US.UTF-8 \
 && systemctl enable ssh \
 && useradd -m -s /bin/bash corpus \
 && echo 'corpus ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/corpus \
 && chmod 440 /etc/sudoers.d/corpus
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
