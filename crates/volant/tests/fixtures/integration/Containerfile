# The throwaway host the integration targets that change the machine, and the script targets, run
# in, as ansible-test's own containers give them: an `en_US.UTF-8` locale, which several targets set,
# and the tools their scripts call. The interpreters come from the reference's virtualenv, mounted
# at its own path.
FROM ubuntu:26.04@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends locales sudo acl git unzip zip rsync openssh-client python3 iproute2 ca-certificates curl file gnupg tzdata sshpass \
 && locale-gen en_US.UTF-8
