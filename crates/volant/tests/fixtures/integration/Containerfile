# The throwaway host the integration targets that change the machine, and the script targets, run
# in, as ansible-test's own containers give them: an `en_US.UTF-8` locale, which several targets set,
# and the tools their scripts call. The interpreters come from the reference's virtualenv, mounted
# at its own path.
FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends locales sudo acl git unzip zip rsync openssh-client python3 iproute2 ca-certificates curl file gnupg tzdata \
 && locale-gen en_US.UTF-8
