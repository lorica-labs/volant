{
  "_ansible_no_log": false,
  "_ansible_verbose_override": true,
  "action": "setup",
  "ansible_facts": {
    "ansible_pkg_mgr": "apt"
  },
  "changed": false,
  "invocation": {
    "module_args": {
      "fact_path": "/etc/ansible/facts.d",
      "filter": [
        "ansible_pkg_mgr"
      ],
      "gather_subset": [
        "!all"
      ],
      "gather_timeout": 10
    }
  }
}
