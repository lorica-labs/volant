---
// Starlight's edit link, plus a link that opens a documentation issue with the page filled in.
import Default from '@astrojs/starlight/components/EditLink.astro';
import { strings } from '../i18n';

const { editUrl, locale } = Astro.locals.starlightRoute;
const t = strings(locale ?? 'en');
const repo = 'https://github.com/lorica-labs/volant';
const page = new URL(Astro.url.pathname, Astro.site).href;
const report = `${repo}/issues/new?template=docs.yml&page=${encodeURIComponent(page)}`;
---

{
  editUrl && (
    <div class="links sl-flex print:hidden">
      <Default />
      <a href={report} class="sl-flex">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
        </svg>
        {t.docs.report}
      </a>
    </div>
  )
}

<style>
  .links {
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  a {
    gap: 0.5rem;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>
