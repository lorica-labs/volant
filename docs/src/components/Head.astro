---
// Starlight's own head, plus the script that frames every diagram and chart, lets each one open
// full screen, and fades figures in as they scroll into view.
import Default from '@astrojs/starlight/components/Head.astro';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
---

<Default />
<!-- Loaded early so diagrams measure their labels with the font they are drawn in. -->
<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />

<script>
  const selector = 'pre.mermaid, figure.flow, figure.timeline, figure.bench';
  const expandIcon =
    '<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';

  function dialog(): HTMLDialogElement {
    let d = document.querySelector<HTMLDialogElement>('dialog.expand-dialog');
    if (d) return d;
    d = document.createElement('dialog');
    d.className = 'expand-dialog';
    d.setAttribute('aria-label', 'Figure, full screen');
    d.innerHTML =
      '<div class="expand-bar"><button type="button" class="expand-btn expand-close">Close</button></div>' +
      '<div class="expand-body"></div>';
    d.querySelector('.expand-close')!.addEventListener('click', () => d!.close());
    // A click on the backdrop lands on the dialog itself, outside its content.
    d.addEventListener('click', (event) => {
      if (event.target === d) d!.close();
    });
    document.body.append(d);
    return d;
  }

  function open(source: Element) {
    const d = dialog();
    const copy = source.cloneNode(true) as Element;
    copy.querySelectorAll('.expand-btn').forEach((b) => b.remove());
    d.querySelector('.expand-body')!.replaceChildren(copy);
    d.showModal();
    markLineStarts(copy);
  }

  // A step that wraps to a new line does not get the connector in front of it: mark the first
  // step of every line, and redo it whenever the list changes width.
  function markLineStarts(root: ParentNode) {
    for (const list of root.querySelectorAll<HTMLElement>('.flow-steps')) {
      const steps = [...list.children] as HTMLElement[];
      steps.forEach((step) => step.classList.remove('is-line-start'));
      // Steps of different heights share a line, so a step opens a new line only when it starts
      // below the bottom of everything on the line before it.
      let lineBottom = -Infinity;
      for (const step of steps) {
        if (step.offsetTop >= lineBottom - 1) {
          step.classList.add('is-line-start');
          lineBottom = step.offsetTop + step.offsetHeight;
        } else {
          lineBottom = Math.max(lineBottom, step.offsetTop + step.offsetHeight);
        }
      }
    }
  }
  // Each step is watched, not only the list: a web font arriving widens the steps and moves them
  // between lines without changing the size of the list itself.
  const relayout = new ResizeObserver((entries) => {
    const lists = new Set(entries.map((entry) => entry.target.closest('.flow')).filter(Boolean));
    lists.forEach((flow) => markLineStarts(flow!));
  });
  document.querySelectorAll('.flow-step').forEach((step) => relayout.observe(step));
  markLineStarts(document);
  document.fonts?.ready.then(() => markLineStarts(document));

  // The keyword grid gets a search field and status filters. Without the script it is the same
  // grid, unfiltered.
  const grid = document.querySelector<HTMLTableElement>('table.kw-grid');
  if (grid) {
    const rows = [...grid.tBodies[0].rows];
    const statuses = [
      ['all', 'All'],
      ['runs', 'Runs'],
      ['partial', 'Partial'],
      ['notyet', 'Not yet'],
    ] as const;
    const count = (status: string) =>
      status === 'all' ? rows.length : rows.filter((row) => row.querySelector(`.kw-${status}`)).length;

    const controls = document.createElement('div');
    controls.className = 'kw-controls not-content';
    controls.innerHTML =
      '<input class="kw-search" type="search" placeholder="Filter keywords" aria-label="Filter keywords" />' +
      '<div class="kw-filters" role="group" aria-label="Show keywords that">' +
      statuses
        // A status no keyword has any more gets no button.
        .filter(([key]) => count(key) > 0)
        .map(
          ([key, label], i) =>
            `<button type="button" class="kw-filter" data-status="${key}" aria-pressed="${i === 0}">` +
            (key === 'all' ? label : `<span class="kw kw-${key}">${label}</span>`) +
            `<span class="kw-count">${count(key)}</span></button>`,
        )
        .join('') +
      '</div>';
    const empty = document.createElement('p');
    empty.className = 'kw-empty';
    empty.hidden = true;
    empty.textContent = 'No keyword matches this filter.';
    const wrap = grid.closest('.kw-grid-wrap')!;
    wrap.before(controls);
    wrap.after(empty);

    // The filter lives in the address, so a link can open the grid already filtered.
    const params = new URL(location.href).searchParams;
    let status = statuses.some(([key]) => key === params.get('status')) ? params.get('status')! : 'all';
    const search = controls.querySelector<HTMLInputElement>('.kw-search')!;
    search.value = params.get('q') ?? '';
    const press = () =>
      controls
        .querySelectorAll<HTMLButtonElement>('.kw-filter')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.status === status)));
    const remember = () => {
      const url = new URL(location.href);
      const needle = search.value.trim();
      needle ? url.searchParams.set('q', needle) : url.searchParams.delete('q');
      status === 'all' ? url.searchParams.delete('status') : url.searchParams.set('status', status);
      history.replaceState(history.state, '', url);
    };
    const apply = () => {
      const needle = search.value.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const name = row.cells[0].textContent!.toLowerCase();
        const visible =
          name.includes(needle) && (status === 'all' || row.querySelector(`.kw-${status}`) !== null);
        row.hidden = !visible;
        if (visible) shown++;
      }
      empty.hidden = shown > 0;
      remember();
    };
    search.addEventListener('input', apply);
    controls.querySelectorAll<HTMLButtonElement>('.kw-filter').forEach((button) => {
      button.addEventListener('click', () => {
        status = button.dataset.status!;
        press();
        apply();
      });
    });
    press();
    if (search.value || status !== 'all') apply();
  }

  // The full support matrix: one search over every table, with the matches listed together above
  // them, so a reader looking for one name does not have to know which section holds it.
  if (location.pathname.endsWith('/reference/parity/')) {
    type Match = { name: string; kind: string; status: string; note: string };
    const rows: Match[] = [];
    for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table')) {
      const heads = [...table.tHead!.rows[0].cells].map((cell) => cell.textContent!.trim());
      if (heads[0] === 'Category') continue;
      let heading: Element | null = table.closest('.sl-markdown-content > *');
      while (heading && !heading.querySelector('h2, h3') && !heading.matches('h2, h3')) {
        heading = heading.previousElementSibling;
      }
      const title = heading?.matches('h2, h3') ? heading : heading?.querySelector('h2, h3');
      const kind = title?.textContent?.trim() ?? '';
      for (const row of table.tBodies[0].rows) {
        const cells = [...row.cells].map((cell) => cell.textContent!.trim());
        rows.push(
          heads[1] === 'Status'
            ? { name: cells[0], kind, status: cells[1], note: cells[2] ?? '' }
            : {
                name: cells[0],
                kind,
                status: `version ${cells[1]}`,
                note: cells.slice(2).map((value, i) => `${heads[i + 2]} ${value}`).join(', '),
              },
        );
      }
    }

    const controls = document.createElement('div');
    controls.className = 'kw-controls not-content';
    controls.innerHTML =
      '<input class="kw-search" type="search" placeholder="Find a module, filter, keyword, option or collection" aria-label="Find a name in the support matrix" />';
    const results = document.createElement('div');
    results.className = 'support-results not-content';
    const first = document.querySelector('.sl-markdown-content h2, .sl-markdown-content .sl-heading-wrapper');
    first?.before(controls, results);

    const search = controls.querySelector<HTMLInputElement>('input')!;
    search.value = new URL(location.href).searchParams.get('q') ?? '';
    const escape = (text: string) =>
      text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const show = () => {
      const needle = search.value.trim().toLowerCase();
      const url = new URL(location.href);
      needle ? url.searchParams.set('q', search.value.trim()) : url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
      if (!needle) {
        results.replaceChildren();
        return;
      }
      const found = rows.filter((row) => row.name.toLowerCase().includes(needle));
      const shown = found.slice(0, 50);
      results.innerHTML =
        `<p class="support-count">${found.length === 0 ? 'No name matches.' : `${found.length} ${found.length === 1 ? 'match' : 'matches'}${found.length > shown.length ? `, the first ${shown.length} shown` : ''}.`}</p>` +
        (shown.length
          ? '<table><thead><tr><th>Name</th><th>Kind</th><th>Status</th><th>Note</th></tr></thead><tbody>' +
            shown
              .map(
                (row) =>
                  `<tr><td><code>${escape(row.name)}</code></td><td>${escape(row.kind)}</td><td>${escape(row.status)}</td><td>${escape(row.note)}</td></tr>`,
              )
              .join('') +
            '</tbody></table>'
          : '');
    };
    search.addEventListener('input', show);
    show();
  }

  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        reveal.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );

  // The button lives in a wrapper, not inside the figure: Mermaid replaces the contents of its
  // block when it renders, which would take a button inside it along.
  for (const el of document.querySelectorAll(selector)) {
    if (el.closest('.expand-dialog')) continue;
    const wrap = document.createElement('div');
    wrap.className = 'expandable reveal';
    el.replaceWith(wrap);
    wrap.append(el);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'expand-btn';
    button.innerHTML = `${expandIcon}<span>Full screen</span>`;
    button.addEventListener('click', () => open(el));
    wrap.append(button);
    reveal.observe(wrap);
  }
</script>
