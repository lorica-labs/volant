---
// Starlight's sidebar with a product switcher on top. With a single product the switcher is a plain
// label; with more, it opens a list of the products and their documentation.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { products } from '../products';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = products[0];
const many = products.length > 1;
---

<div class="product-switcher not-content">
  {
    many ? (
      <details class="ps-menu">
        <summary class="ps-current" style={`--ps-colour: ${current.colour}`}>
          <span class="ps-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={current.icon} /></svg></span>
          <span class="ps-text">
            <span class="ps-name">{current.name}</span>
            <span class="ps-desc">{current.description}</span>
          </span>
          <svg class="ps-chevron" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <ul class="ps-list">
          {products.map((product) => (
            <li>
              <a
                href={`${base}${product.href}`}
                style={`--ps-colour: ${product.colour}`}
                aria-current={product === current ? 'true' : undefined}
              >
                <span class="ps-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={product.icon} /></svg></span>
                <span class="ps-text">
                  <span class="ps-name">{product.name}</span>
                  <span class="ps-desc">{product.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <a class="ps-current" href={`${base}${current.href}`} style={`--ps-colour: ${current.colour}`}>
        <span class="ps-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={current.icon} /></svg></span>
        <span class="ps-text">
          <span class="ps-name">{current.name}</span>
          <span class="ps-desc">{current.description}</span>
        </span>
      </a>
    )
  }
</div>
<Default />

<script>
  // Top-level groups always stay open, whatever state an earlier visit saved: their label is a
  // heading. Nested groups, such as the decision records, still fold.
  for (const summary of document.querySelectorAll<HTMLElement>(
    '.sidebar-content .top-level > li > details > summary',
  )) {
    (summary.parentElement as HTMLDetailsElement).open = true;
    summary.tabIndex = -1;
    summary.addEventListener('click', (event) => event.preventDefault());
  }
</script>

<style>
  .product-switcher {
    margin-bottom: 1.25rem;
  }
  .ps-current {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--v-hairline-strong);
    border-radius: 0.75rem;
    background: var(--v-shell);
    color: var(--sl-color-white);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition: border-color 0.3s var(--v-ease), background-color 0.3s var(--v-ease);
  }
  .ps-current::-webkit-details-marker {
    display: none;
  }
  .ps-current:hover {
    border-color: var(--sl-color-gray-4);
  }
  .ps-mark {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.45rem;
    background: var(--ps-colour);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    display: grid;
    place-items: center;
  }
  .ps-mark svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #0b0d0f;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ps-text {
    display: grid;
    min-width: 0;
  }
  .ps-name {
    font-weight: 600;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
  }
  .ps-desc {
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ps-chevron {
    margin-inline-start: auto;
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s var(--v-ease);
  }
  .ps-menu[open] .ps-chevron {
    transform: rotate(180deg);
  }
  .ps-list {
    display: grid;
    gap: 0.125rem;
    margin: 0.375rem 0 0;
    padding: 0.375rem;
    border: 1px solid var(--v-hairline-strong);
    border-radius: 0.75rem;
    background: var(--v-core);
    list-style: none;
  }
  .ps-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .ps-list a:hover,
  .ps-list a[aria-current='true'] {
    background: var(--v-shell);
  }
</style>
