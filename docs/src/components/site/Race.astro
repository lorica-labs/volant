---
// Each measured workload as two lanes that fill as the runs did. Every race plays in five seconds;
// the clocks count the measured seconds, so the lanes keep the real proportions.
import { measuredOn, reference, workloads } from '../../lib/bench';

const playback = 5;
---

<figure class="race panel" data-playback={playback} style={`--playback: ${playback}s`}>
  <div class="core">
    {
      workloads.map((w) => (
        <div class="workload">
          <p class="name">
            {w.name}
            <span>{w.detail}</span>
          </p>
          {[
            { label: 'ansible-core', seconds: w.ansible, fast: false },
            { label: 'Volant', seconds: w.volant, fast: true },
          ].map((lane) => (
            <div class:list={['lane', { fast: lane.fast }]}>
              <span class="who">{lane.label}</span>
              <span class="track">
                <span class="fill" style={`--share: ${lane.seconds / w.ansible}`} />
              </span>
              <span class="clock mono" data-seconds={lane.seconds}>
                {lane.seconds.toFixed(3)} s
              </span>
            </div>
          ))}
        </div>
      ))
    }
    <figcaption>
      Median of three timed passes on {measuredOn}, against {reference}. Both engines end every pass on the same
      recap. Each race plays back in {playback} seconds.
    </figcaption>
  </div>
</figure>

<script>
  for (const race of document.querySelectorAll<HTMLElement>('.race')) {
    const playback = Number(race.dataset.playback) * 1000;
    const clocks = [...race.querySelectorAll<HTMLElement>('.clock')];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) {
      race.classList.add('done');
      continue;
    }
    race.classList.add('ready');
    const play = () => {
      race.classList.add('running');
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / playback, 1);
        for (const clock of clocks) {
          const seconds = Number(clock.dataset.seconds);
          const workload = clock.closest('.workload')!;
          const longest = Number(workload.querySelector<HTMLElement>('.clock')!.dataset.seconds);
          // The run ends when its share of the race is over; until then the clock counts up.
          const shown = Math.min(seconds, t * longest);
          clock.textContent = `${shown.toFixed(3)} s`;
          clock.classList.toggle('stopped', shown >= seconds);
        }
        if (t < 1) requestAnimationFrame(step);
        else race.classList.add('done');
      };
      requestAnimationFrame(step);
    };
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        play();
      },
      { threshold: 0.5 },
    ).observe(race);
  }
</script>

<style>
  .race {
    margin: 0;
  }
  .core {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .name {
    display: grid;
    gap: 0.2rem;
    margin-bottom: 0.9rem;
    font-weight: 600;
  }
  .name span {
    color: var(--fg-3);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .lane {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 6rem;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
  .who {
    color: var(--fg-2);
  }
  .fast .who {
    color: var(--fg);
    font-weight: 600;
  }
  .track {
    position: relative;
    height: 0.75rem;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    min-width: 3px;
    border-radius: 999px;
    background: var(--fg-4);
    transform-origin: left;
  }
  .fast .fill {
    background: var(--brand);
  }
  .clock {
    color: var(--fg-3);
    text-align: end;
  }
  .clock.stopped,
  .done .clock {
    color: var(--fg);
  }
  .fast .clock.stopped,
  .done .fast .clock {
    color: var(--brand-hi);
  }
  /* Before the race starts the lanes are empty; each one grows for its own share of the playback. */
  .ready .fill {
    transform: scaleX(0);
  }
  .running .fill {
    transform: scaleX(1);
    transition: transform calc(var(--share) * var(--playback)) linear;
  }
  figcaption {
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  @media (max-width: 40rem) {
    .lane {
      grid-template-columns: 5.5rem minmax(0, 1fr) 4.75rem;
      gap: 0.6rem;
    }
  }
</style>
