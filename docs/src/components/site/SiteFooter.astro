---
import Mark from './Mark.astro';
import { repo } from '../../nav';
import { localize, strings } from '../../i18n';

const { code } = Astro.props as { code: string };
const t = strings(code);
const f = t.footer;
const columns = [
  {
    title: f.use,
    links: [
      [f.installation, '/docs/start/installation/'],
      [f.quickstart, '/docs/start/quickstart/'],
      [f.willItRun, '/docs/start/compatibility/'],
      [f.whenItFails, '/docs/start/troubleshooting/'],
      [f.leaves, '/docs/#what-volant-leaves-on-your-machines'],
      [f.uninstall, '/docs/start/installation/#uninstall'],
    ],
  },
  {
    title: f.reference,
    links: [
      [f.cli, '/docs/reference/cli/'],
      [f.configuration, '/docs/reference/configuration/'],
      [f.matrix, '/docs/reference/parity/'],
      [f.changelog, '/docs/changelog/'],
    ],
  },
  {
    title: f.project,
    links: [
      [t.nav.performance, '/performance/'],
      [t.nav.compatibility, '/compatibility/'],
      [t.nav.community, '/community/'],
      [t.nav.blog, '/blog/'],
      [f.roadmap, '/docs/project/roadmap/'],
    ],
  },
  {
    title: f.source,
    links: [
      ['GitHub', repo],
      [f.contributing, `${repo}/blob/main/CONTRIBUTING.md`],
      [f.security, `${repo}/blob/main/SECURITY.md`],
      [f.license, `${repo}/blob/main/LICENSE`],
    ],
  },
];
---

<footer>
  <div class="wrap grid">
    <div class="about">
      <a class="logo" href={localize(code, '/')} aria-label={t.header.home}><Mark size={22} /> <span>Volant</span></a>
      <p>{f.about}</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="title">{column.title}</p>
          {column.links.map(([label, href]) => (
            <a href={localize(code, href)}>{label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="wrap legal">
    <span>{f.telemetry}</span>
    <span set:html={f.name} />
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 3.5rem 2rem;
    color: var(--fg-3);
    font-size: 0.9rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brand);
    font-weight: 680;
  }
  .logo span {
    color: var(--fg);
  }
  .about p {
    margin-top: 0.75rem;
    max-width: 30ch;
  }
  nav {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .title {
    margin-bottom: 0.25rem;
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  nav a {
    transition: color 0.2s var(--ease);
  }
  nav a:hover {
    color: var(--fg);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
  }
  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
