---
// The header of the site pages: the same mark, sections and install button as the documentation.
import Mark from './Mark.astro';
import { currentSection, nav, repo } from '../../nav';

const current = currentSection(Astro.url.pathname);
---

<header class="nav">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Volant, home">
      <Mark />
      <span>Volant</span>
    </a>
    <a class="version mono" href="/docs/changelog/" title="Release notes">v{__VOLANT_VERSION__}</a>
    <nav class="links" aria-label="Main">
      {
        nav.map((link) => (
          <a href={link.href} aria-current={link.label === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="right">
      <a class="icon" href={repo} aria-label="Volant on GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
          ></path>
        </svg>
      </a>
      <a class="btn btn-brand install" href="/docs/start/installation/">Install</a>
      <details class="menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75"
            stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <div class="drawer">
          {nav.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={repo}>GitHub</a>
          <a class="btn btn-brand" href="/docs/start/installation/">Install</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--nav-h);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--brand);
    font-size: 1.2rem;
    font-weight: 680;
    letter-spacing: -0.02em;
  }
  .logo span {
    color: var(--fg);
  }
  .version {
    margin-inline-start: -0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--fg-3);
    font-size: 0.72rem;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .version:hover {
    color: var(--fg);
    border-color: var(--fg-4);
  }
  .links {
    display: flex;
    gap: 0.25rem;
  }
  .links a {
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
    color: var(--fg-2);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
    background: rgb(255 255 255 / 0.03);
  }
  .links a[aria-current='page'] {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-inline-start: auto;
  }
  .icon {
    display: grid;
    place-items: center;
    color: var(--fg-2);
    transition: color 0.2s var(--ease);
  }
  .icon:hover {
    color: var(--fg);
  }
  .install {
    height: 2.25rem;
    padding: 0 0.9rem;
    font-size: 0.875rem;
  }
  .menu {
    display: none;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .drawer {
    position: fixed;
    inset: var(--nav-h) 0 0;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem;
    background: var(--bg);
  }
  .drawer a:not(.btn) {
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
  }
  .drawer .btn {
    justify-content: center;
    margin-top: 1rem;
  }
  @media (max-width: 52rem) {
    .links,
    .version,
    .install,
    .icon {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
