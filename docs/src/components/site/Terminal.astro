---
// A terminal that replays a session line by line when it scrolls into view. The text is the real
// output, so it reads the same without scripts and under reduced motion.
interface Line {
  text: string;
  /** `cmd` is typed after a prompt; the others appear at once. */
  kind?: 'cmd' | 'out' | 'ok' | 'changed' | 'dim';
}
interface Props {
  title: string;
  lines: Line[];
}
const { title, lines } = Astro.props;
---

<figure class="terminal panel">
  <div class="core">
    <div class="bar"><span></span><span></span><span></span><p class="mono">{title}</p></div>
    <pre class="mono screen">{
      lines.map((line) => (
        <span class:list={['line', line.kind ?? 'out']} data-kind={line.kind ?? 'out'}>{line.text}{'\n'}</span>
      ))
    }</pre>
  </div>
</figure>

<script>
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  for (const term of document.querySelectorAll<HTMLElement>('.terminal')) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const lines = [...term.querySelectorAll<HTMLElement>('.line')];
    const texts = lines.map((line) => line.textContent ?? '');
    lines.forEach((line) => (line.hidden = true));
    const play = async () => {
      for (const [i, line] of lines.entries()) {
        line.hidden = false;
        if (line.dataset.kind === 'cmd') {
          const full = texts[i];
          line.classList.add('typing');
          for (let n = 0; n <= full.length - 1; n++) {
            line.textContent = full.slice(0, n) + '\n';
            await wait(28);
          }
          line.textContent = full;
          line.classList.remove('typing');
          await wait(350);
        } else {
          await wait(line.textContent!.trim() ? 90 : 30);
        }
      }
    };
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        play();
      },
      { threshold: 0.4 },
    ).observe(term);
  }
</script>

<style>
  .terminal {
    margin: 0;
    min-width: 0;
  }
  .core {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .bar p {
    margin-inline-start: 0.6rem;
    color: var(--fg-3);
    font-size: 0.78rem;
  }
  .screen {
    min-height: 100%;
    margin: 0;
    padding: 1.1rem 1.25rem 1.4rem;
    overflow-x: auto;
    color: var(--fg-2);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .cmd {
    color: var(--fg);
  }
  .cmd::before {
    content: '$ ';
    color: var(--brand);
  }
  .typing::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-inline-start: 1px;
    vertical-align: -0.2em;
    background: var(--brand);
  }
  .ok {
    color: #7fd3a1;
  }
  .changed {
    color: #e0b25c;
  }
  .dim {
    color: var(--fg-4);
  }
</style>
