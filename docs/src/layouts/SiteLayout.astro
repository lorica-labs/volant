---
// The frame of every site page outside the documentation.
import '../styles/site.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { localeOf, localize, locales, stripLocale, strings } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** The language of the page; the blog leaves it out and stays in English. */
  code?: string;
}

const { title, description, code = 'en' } = Astro.props;
const t = strings(code);
const canonical = new URL(Astro.url.pathname, Astro.site);
const page = stripLocale(Astro.url.pathname);
const fullTitle = page === '/' ? title : `${title} | Volant`;
// The same page in every language, unless it exists in English only.
const alternates =
  localize('fr', page) === page
    ? []
    : [
        ...locales.map((l) => ({ lang: l.lang, href: new URL(localize(l.code, page), Astro.site) })),
        { lang: 'x-default', href: new URL(page, Astro.site) },
      ];
---

<!doctype html>
<html lang={localeOf(code).lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Volant blog" href="/blog/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0d0f" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{t.header.skip}</a>
    <SiteHeader code={code} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter code={code} />
    <script>
      // Elements marked .reveal fade in once, as they scroll into view.
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            seen.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));
    </script>
  </body>
</html>
