---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { day, posts } from '../../lib/blog';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <header>
      <a class="back" href="/blog/">Blog</a>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <time class="mono" datetime={post.data.date.toISOString()}>{day(post.data.date)}</time>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer>
      <a class="text-link" href="/blog/">Every post</a>
      <a class="text-link" href="/blog/rss.xml">RSS feed</a>
    </footer>
  </article>
</SiteLayout>

<style>
  .post {
    max-width: 46rem;
    padding-block: clamp(3.5rem, 7vw, 5rem);
  }
  .back {
    color: var(--fg-3);
    font-size: 0.875rem;
  }
  .back::before {
    content: '← ';
  }
  .back:hover {
    color: var(--fg);
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 4.5vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .lede {
    margin-top: 1rem;
    color: var(--fg-2);
    font-size: 1.15rem;
  }
  time {
    display: block;
    margin-top: 1rem;
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .prose {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--fg-2);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin: 2.5rem 0 0.75rem;
    color: var(--fg);
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.5rem;
    color: var(--fg);
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(table) {
    margin: 0 0 1.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.35rem;
  }
  .prose :global(a) {
    color: var(--brand-hi);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .prose :global(strong) {
    color: var(--fg);
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: 0.65rem;
    background: var(--bg-2) !important;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.85rem;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.925rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: start;
  }
  .prose :global(th) {
    color: var(--fg);
  }
  footer {
    display: flex;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
