---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { day, posts } from '../../lib/blog';

const all = await posts();
---

<SiteLayout title="Blog" description="Releases, measurements and design notes from the Volant project.">
  <section class="wrap page-head">
    <h1>Blog.</h1>
    <p>
      Releases, measurements and design notes from the project. Follow it with the{' '}
      <a class="text-link" href="/blog/rss.xml">RSS feed</a>.
    </p>
  </section>

  <section class="section">
    <div class="wrap">
      {
        all.length === 0 ? (
          <p class="empty">No post yet. The <a class="text-link" href="/docs/changelog/">changelog</a> has every release.</p>
        ) : (
          <ul class="posts">
            {all.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <time class="mono" datetime={post.data.date.toISOString()}>{day(post.data.date)}</time>
                  <span class="text">
                    <b>
                      {post.data.title}
                      {post.data.draft && <em class="draft">draft</em>}
                    </b>
                    <span>{post.data.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</SiteLayout>

<style>
  .posts {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  time {
    color: var(--fg-3);
    font-size: 0.875rem;
    line-height: 1.9;
  }
  .text {
    display: grid;
    gap: 0.35rem;
  }
  b {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.2s var(--ease);
  }
  a:hover b {
    color: var(--brand-hi);
  }
  .text > span {
    color: var(--fg-2);
  }
  .draft {
    margin-inline-start: 0.6rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--state-changed);
    color: var(--state-changed);
    font: 500 0.7rem var(--f-mono);
    vertical-align: 0.2em;
  }
  .empty {
    color: var(--fg-2);
  }
  @media (max-width: 36rem) {
    .posts a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
  }
</style>
