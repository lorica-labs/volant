---
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, category, collections, core, later, partly, running, total } from '../lib/parity';

const groups = [
  { title: 'The playbook language', names: ['keyword (play)', 'keyword (block)', 'keyword (task)', 'keyword (loop_control)', 'meta action', 'YAML tag'] },
  { title: 'Modules and templating', names: ['module', 'action plugin', 'filter', 'test', 'lookup'] },
  { title: 'Hosts, runs and the command line', names: ['ansible-playbook option', 'inventory', 'connection', 'become', 'strategy', 'shell', 'vars', 'cache', 'callback'] },
  { title: 'Collections in the ansible package', names: categories.filter((c) => c.name.startsWith('collection')).map((c) => c.name) },
].map((group) => ({ ...group, rows: group.names.map(category) }));

const share = (n: number, of: number) => `${Math.floor((n / of) * 1000) / 10}%`;
const label = (name: string) => name.replace(/^collection /, '');

const steps = [
  ['Read it without running it', 'volant playbook -i inventory.ini site.yml --syntax-check', 'Listings and --syntax-check never stop on something unsupported, so they work on any playbook.'],
  ['Compare the task list', 'volant playbook -i inventory.ini site.yml --list-tasks', 'If it matches what ansible-playbook --list-tasks prints, Volant compiled your roles, imports and tags the same way.'],
  ['Run it on one host', 'volant playbook -i inventory.ini site.yml --limit test1', 'Most of what this release cannot run stops the run before it connects, names what it refused, and exits with code 4.'],
];
---

<SiteLayout
  title="Compatibility"
  description="How much of ansible-core 2.19.12 and of the ansible package Volant runs today, measured name by name by the test suite."
>
  <section class="wrap page-head">
    <h1>Compatible with ansible-core 2.19, name by name.</h1>
    <p>
      Volant loads the whole ansible-core 2.19 grammar and reproduces its behaviour, so any difference is a bug. The test
      suite lists every keyword, option and plugin ansible-core ships and checks what this release does with each.
    </p>
    <div class="totals">
      <div>
        <b class="mono">{share(running(core), total(core))}</b>
        <span>of ansible-core runs: {running(core)} of {total(core)} names, {partly(core)} more in part</span>
      </div>
      <div>
        <b class="mono">{share(running(collections), total(collections))}</b>
        <span>
          of the collections’ modules and plugins: {running(collections).toLocaleString('en')} of
          {total(collections).toLocaleString('en')}. Most of the {later(collections).toLocaleString('en')} others come
          with Windows and network device support.
        </span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="legend">
        <span><i class="runs"></i>runs</span>
        <span><i class="partial"></i>partial: an argument or a value is missing</span>
        <span><i class="later"></i>later: Windows, other connections, other output callbacks</span>
      </div>
      <div class="groups">
        {
          groups.map((group) => (
            <section class="group panel reveal">
              <div class="core">
                <h2>{group.title}</h2>
                {group.rows.map((c) => {
                  const all = c.runs + c.partial + c.notYet + c.later;
                  return (
                    <div class="row">
                      <span class="name">{label(c.name)}</span>
                      <span class="bar" title={`${c.runs} run, ${c.partial} partial, ${c.later} later`}>
                        <i class="runs" style={`--w: ${(c.runs / all) * 100}%`} />
                        <i class="partial" style={`--w: ${(c.partial / all) * 100}%`} />
                        <i class="later" style={`--w: ${((c.later + c.notYet) / all) * 100}%`} />
                      </span>
                      <span class="count mono">
                        {c.runs.toLocaleString('en')}/{all.toLocaleString('en')}
                      </span>
                    </div>
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
      <form class="lookup reveal" action="/docs/reference/parity/" method="get">
        <label for="lookup">Look up one name in the full support matrix</label>
        <div>
          <input id="lookup" name="q" type="search" placeholder="copy, community.general, json_query, --diff" />
          <button class="btn btn-brand" type="submit">Look up</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Check your own project.</h2>
        <p>Three commands, and the first two never touch a host.</p>
      </div>
      <ol class="steps">
        {
          steps.map(([title, command, note]) => (
            <li class="reveal">
              <h3>{title}</h3>
              <pre class="code panel"><code class="core">{command}</code></pre>
              <p>{note}</p>
            </li>
          ))
        }
      </ol>
      <p class="more reveal">
        A few gaps are silent: a run can ignore a setting there without an error.
        <a class="text-link" href="/docs/start/compatibility/#known-gaps">Read the known gaps</a> before a run that
        matters.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .totals {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    margin-top: 2.5rem;
  }
  .totals div {
    display: grid;
    gap: 0.3rem;
    max-width: 22rem;
  }
  .totals b {
    color: var(--brand-hi);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .totals span {
    color: var(--fg-3);
    font-size: 0.925rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legend i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
  }
  .runs {
    background: var(--brand);
  }
  .partial {
    background: #c98a0b;
  }
  .later {
    background: var(--fg-4);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .group .core {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.5rem;
  }
  .group h2 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }
  .row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 6.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }
  .name {
    color: var(--fg-2);
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.55rem;
  }
  .bar i {
    width: var(--w);
    border-radius: 999px;
  }
  .count {
    color: var(--fg);
    text-align: end;
  }
  .lookup {
    display: grid;
    gap: 0.6rem;
    max-width: 40rem;
    margin-top: 2.5rem;
  }
  .lookup label {
    font-weight: 560;
  }
  .lookup div {
    display: flex;
    gap: 0.5rem;
  }
  .lookup input {
    flex: 1;
    min-width: 0;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--line-2);
    border-radius: 0.55rem;
    background: var(--bg-2);
    color: var(--fg);
    font: 0.95rem var(--f-sans);
  }
  .lookup input::placeholder {
    color: var(--fg-3);
  }
  .lookup input:focus {
    border-color: var(--brand);
    outline: none;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }
  .steps h3 {
    font-size: 1.05rem;
  }
  .steps h3::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-inline-end: 0.6rem;
    border-radius: 999px;
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font: 500 0.8rem var(--f-mono);
  }
  .steps pre {
    padding: 0.375rem;
  }
  .steps pre code {
    display: block;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    background: var(--bg-2);
    box-shadow: none;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .steps p {
    color: var(--fg-2);
    font-size: 0.925rem;
  }
  .more {
    margin-top: 2rem;
    color: var(--fg-2);
  }
  @media (max-width: 60rem) {
    .groups,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .lookup div {
      flex-direction: column;
    }
  }
</style>
