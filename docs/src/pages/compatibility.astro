---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lookup from '../components/site/Lookup.astro';
import { categories, category, collections, core, later, partly, running, total } from '../lib/parity';

const groups = [
  { title: 'The playbook language', names: ['keyword (play)', 'keyword (block)', 'keyword (task)', 'keyword (loop_control)', 'meta action', 'YAML tag'] },
  { title: 'Modules and templating', names: ['module', 'action plugin', 'filter', 'test', 'lookup'] },
  { title: 'Hosts, runs and the command line', names: ['ansible-playbook option', 'inventory', 'connection', 'become', 'strategy', 'shell', 'vars', 'cache', 'callback'] },
  { title: 'Collections in the ansible package', names: categories.filter((c) => c.name.startsWith('collection')).map((c) => c.name) },
].map((group) => ({ ...group, rows: group.names.map(category) }));

const share = (n: number, of: number) => `${Math.floor((n / of) * 1000) / 10}%`;
const label = (name: string) => name.replace(/^collection /, '');

const steps = [
  ['Read it without running it', 'volant playbook -i inventory.ini site.yml --syntax-check', 'Listings and --syntax-check never stop on something unsupported, so they work on any playbook.'],
  ['Compare the task list', 'volant playbook -i inventory.ini site.yml --list-tasks', 'If it matches what ansible-playbook --list-tasks prints, Volant compiled your roles, imports and tags the same way.'],
  ['Run it on one host', 'volant playbook -i inventory.ini site.yml --limit test1', 'Most of what this release cannot run stops the run before it connects, names what it refused, and exits with code 4.'],
];
---

<SiteLayout
  title="Compatibility"
  description="How much of ansible-core 2.19.12 and of the ansible package Volant runs today, measured name by name by the test suite."
>
  <section class="wrap page-head">
    <h1>Compatible with ansible-core 2.19, name by name.</h1>
    <p>
      Volant loads the whole ansible-core 2.19 grammar and reproduces its behaviour, so any difference is a bug. The test
      suite lists every keyword, option and plugin ansible-core ships and checks what this release does with each.
    </p>
    <div class="totals">
      <div>
        <b class="mono">{share(running(core), total(core))}</b>
        <span>of ansible-core runs: {running(core)} of {total(core)} names, {partly(core)} more in part</span>
      </div>
      <div>
        <b class="mono">{share(running(collections), total(collections))}</b>
        <span>
          of the collections’ modules and plugins: {running(collections).toLocaleString('en')} of{' '}
          {total(collections).toLocaleString('en')}. Most of the {later(collections).toLocaleString('en')} others come
          with Windows and network device support.
        </span>
      </div>
    </div>
    <div class="head-lookup"><Lookup id="compat-lookup" /></div>
    <p class="also">
      Checking one project? <a class="text-link" href="/docs/start/compatibility/">Will my playbook run?</a> shows the
      three commands, and the <a class="text-link" href="#known-gaps-note">known gaps</a> list what fails without a message.
    </p>
  </section>

  <section class="sheet">
    <div class="wrap">
      <div class="legend">
        <span><i class="runs"></i>runs</span>
        <span><i class="partial"></i>partial: an argument or a value is missing</span>
        <span><i class="later"></i>later: Windows, other connections, other output callbacks</span>
        <span>The numbers are read from the support matrix the test suite generates.</span>
      </div>
      <div class="groups">
        {
          groups.map((group) => (
            <section class="group panel reveal">
              <div class="core">
                <h2 class="flap" data-flap={group.title}>{group.title}</h2>
                {group.rows.map((c) => {
                  const all = c.runs + c.partial + c.notYet + c.later;
                  return (
                    <div class="row">
                      <span class="name">{label(c.name)}</span>
                      <span class="bar" aria-hidden="true">
                        {c.runs > 0 && <i class="runs" style={`flex-grow: ${c.runs}`} />}
                        {c.partial > 0 && <i class="partial" style={`flex-grow: ${c.partial}`} />}
                        {c.later + c.notYet > 0 && <i class="later" style={`flex-grow: ${c.later + c.notYet}`} />}
                      </span>
                      <span class="count mono">
                        {c.runs.toLocaleString('en')}/{all.toLocaleString('en')}
                        {c.partial > 0 && <em>{c.partial} partial</em>}
                        {c.later + c.notYet > 0 && <em>{(c.later + c.notYet).toLocaleString('en')} later</em>}
                      </span>
                    </div>
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Check your own project.</h2>
        <p>Three commands, and the first two never touch a host.</p>
      </div>
      <ol class="steps">
        {
          steps.map(([title, command, note]) => (
            <li class="reveal">
              <h3>{title}</h3>
              <pre class="code panel"><code class="core">{command}</code></pre>
              <p>{note}</p>
            </li>
          ))
        }
      </ol>
      <p class="more reveal" id="known-gaps-note">
        A few gaps are silent: a run can ignore a setting there without an error.{' '}
        <a class="text-link" href="/docs/start/compatibility/#known-gaps">Read the known gaps</a> before a run that
        matters.
      </p>
    </div>
  </section>
</SiteLayout>

<script>
  // Each group title arrives like a split-flap departure board: its letters run through the
  // alphabet and settle on the real word, left to right.
  const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  const flap = (el: HTMLElement) => {
    const word = el.dataset.flap!;
    const start = performance.now();
    const step = (now: number) => {
      const t = now - start;
      let done = true;
      el.textContent = [...word]
        .map((ch, i) => {
          if (ch === ' ' || t > 260 + i * 28) return ch;
          done = false;
          return glyphs[Math.floor(Math.random() * glyphs.length)];
        })
        .join('');
      if (!done) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          seen.unobserve(entry.target);
          flap(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>('.flap').forEach((el) => seen.observe(el));
  }
</script>

<style>
  .totals {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    margin-top: 2.5rem;
  }
  .totals div {
    display: grid;
    gap: 0.3rem;
    max-width: 22rem;
  }
  .totals b {
    color: var(--brand-hi);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .totals span {
    color: var(--fg-3);
    font-size: 0.925rem;
  }
  .head-lookup {
    margin-top: 2.5rem;
  }
  .also {
    margin-top: 1rem;
    color: var(--fg-2);
    font-size: 0.925rem;
  }

  /* The reference part of the page is printed on paper, as a datasheet. */
  /* The paper fades in from the dark page and back out to it, so the page never flips from black
     to white at a hard edge. The ruled lines follow the same fade. */
  .sheet {
    position: relative;
    isolation: isolate;
    padding-block: clamp(7rem, 12vw, 10rem);
    background: linear-gradient(
      var(--bg) 0,
      var(--paper) 9rem,
      var(--paper) calc(100% - 9rem),
      var(--bg) 100%
    );
    color: var(--ink);
  }
  .sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(var(--paper-2) 1px, transparent 1px) 0 0 / 100% 2rem;
    mask-image: linear-gradient(transparent 0 9rem, #000 12rem, #000 calc(100% - 12rem), transparent calc(100% - 9rem));
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legend i {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
  }
  .runs {
    background: var(--ink-brand);
  }
  .partial {
    background: var(--ink-partial);
  }
  /* What comes later is hatched, so it reads as not there yet without a colour of its own. */
  .later {
    background: repeating-linear-gradient(135deg, var(--ink-3) 0 2px, transparent 2px 5px);
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .group {
    border-color: rgb(18 25 28 / 0.12);
    background: rgb(18 25 28 / 0.03);
  }
  .group .core {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    border-color: rgb(18 25 28 / 0.1);
    background: #fff;
    box-shadow: 0 1px 2px rgb(18 25 28 / 0.06);
  }
  .group h2 {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .row {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr) 8.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }
  .name {
    color: var(--ink-2);
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.6rem;
  }
  /* Each segment grows by its count, so the segments and the gaps between them fill the track
     exactly and every bar ends at the same place. */
  .bar i {
    flex: 0 1 0;
    min-width: 3px;
    border-radius: 2px;
  }
  .count {
    display: grid;
    justify-items: end;
    color: var(--ink);
    text-align: end;
  }
  .count em {
    color: var(--ink-3);
    font-size: 0.75rem;
    font-style: normal;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }
  .steps h3 {
    font-size: 1.05rem;
  }
  .steps h3::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-inline-end: 0.6rem;
    border-radius: 999px;
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font: 500 0.8rem var(--f-mono);
  }
  .steps pre {
    padding: 0.375rem;
  }
  .steps pre code {
    display: block;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    background: var(--bg-2);
    box-shadow: none;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .steps p {
    color: var(--fg-2);
    font-size: 0.925rem;
  }
  .more {
    margin-top: 2rem;
    color: var(--fg-2);
  }
  @media (max-width: 60rem) {
    .groups,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
