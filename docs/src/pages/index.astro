---
import SiteLayout from '../layouts/SiteLayout.astro';
import AsciiWheel from '../components/site/AsciiWheel.astro';
import CopyCommand from '../components/site/CopyCommand.astro';
import RunConsole from '../components/site/RunConsole.astro';
import { ratio, workloads } from '../lib/bench';
import { core, running, total } from '../lib/parity';
import { posts } from '../lib/blog';
import { repo } from '../nav';

const coreShare = Math.floor((running(core) / total(core)) * 1000) / 10;
const fastest = workloads.reduce((a, b) => (ratio(a) > ratio(b) ? a : b));
const latest = (await posts()).slice(0, 3);

const files = [
  ['ansible.cfg', 'read from the same places, with the same precedence'],
  ['Inventories', 'INI, YAML, TOML, scripts and inventory plugins'],
  ['group_vars and host_vars', 'layered in Ansible’s order'],
  ['Vault', 'vaulted files and values, --ask-vault-pass and --vault-id'],
  ['Roles and collections', 'dependencies, argument specs and installed collections'],
  ['Command line', 'the options of ansible-playbook, including --check and --diff'],
];

const promises = [
  ['Your files stay yours', 'No conversion step and no new format. The same files keep working with ansible-playbook.'],
  ['Refusals come first', 'Most of what this release cannot run is named before the first connection, and nothing runs.'],
  ['Linux over SSH first', 'Linux hosts over SSH and local connections today. Windows and network devices come later.'],
  ['No telemetry', 'Volant makes no network call other than the ones your playbook asks for, and the runtime download.'],
];
---

<SiteLayout
  title="Volant: your Ansible playbooks, run by a fast engine written in Rust"
  description="Volant reads the playbooks, roles and inventories you already have and runs them against Linux hosts over SSH, much faster than ansible-playbook."
>
  <section class="hero" data-wheel-area>
    <AsciiWheel />
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Your Ansible playbooks, run by a fast engine written&nbsp;in&nbsp;Rust.</h1>
        <p class="lede">
          Volant reads the playbooks, roles and inventories you already have and runs them over SSH. Nothing to convert.
        </p>
        <div class="install">
          <CopyCommand command="curl -fsSL https://volant.sh/install.sh | sh" />
          <p class="platforms">Linux and macOS, x86_64 and arm64. Ansible is not needed. Windows is not supported yet.</p>
        </div>
        <div class="ctas">
          <a class="btn btn-brand" href="/docs/start/quickstart/">
            Quickstart
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-line" href={repo}>Source on GitHub</a>
        </div>
        <p class="status">
          <span class="badge mono">pre-alpha</span>
          It runs real playbooks, not every playbook yet. Try it on a host you can afford to touch, and see
          <a class="text-link" href="/docs/#what-volant-leaves-on-your-machines">what it leaves on your machines</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>One run, five hosts.</h2>
        <p>
          A real run of Volant, replayed. Each spoke of the wheel stands for a host and takes the colour of the result it
          returns, in the colours ansible-playbook uses.
        </p>
      </div>
      <div class="reveal console-wrap"><RunConsole /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>How it works.</h2>
        <p>
          ansible-playbook pays for a new Python interpreter on the host for every task. Volant pays once per run, and
          keeps one connection open for the rest.
        </p>
      </div>
      <div class="lanes reveal">
        <div class="lane-card panel">
          <div class="core">
            <p class="lane-title">ansible-playbook <span>for every task, on every host</span></p>
            <ol class="steps slow">
              <li>build the module payload</li>
              <li>send it over SSH</li>
              <li>start Python</li>
              <li>import module_utils</li>
              <li>run the module</li>
            </ol>
          </div>
        </div>
        <div class="lane-card panel">
          <div class="core">
            <p class="lane-title">Volant <span>once per run</span></p>
            <ol class="steps once">
              <li>upload a small agent, cached on the host</li>
              <li>open one SSH connection per host</li>
            </ol>
            <p class="lane-title">then <span>for every task</span></p>
            <ol class="steps fast">
              <li>send the task over the open link</li>
              <li>answer it in Rust, or fork a warm Python</li>
            </ol>
          </div>
        </div>
      </div>
      <p class="note reveal">
        Common modules such as <code>apt</code>, <code>systemd</code>, <code>file</code>, <code>lineinfile</code> and
        fact gathering are answered in Rust by the agent when a task’s arguments allow it. Every other module runs in
        Python, in a server that loaded its imports once.
        <a class="text-link" href="/docs/internals/architecture/">How the engine is built</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head reveal">
        <h2>Same files, same command.</h2>
        <p>
          <code>volant playbook</code> takes the options of <code>ansible-playbook</code> and prints the output you
          know, down to the recap. Everything your project already has is read as it is.
        </p>
        <p><a class="text-link" href="/docs/start/quickstart/">Run your first playbook</a></p>
      </div>
      <dl class="files reveal">
          {
            files.map(([name, what]) => (
              <div>
                <dt>{name}</dt>
                <dd>{what}</dd>
              </div>
            ))
          }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head reveal">
        <h2>It says no before it touches a host.</h2>
        <p>
          Volant checks the whole playbook before it connects. Most of what this release cannot run is named there, with
          the play or task it is in, and the run stops with code 4. Nothing has changed on any host.
        </p>
        <p>
          <code>--syntax-check</code> and the listings never stop on what is not supported, and <code>--check</code> with
          <code>--diff</code> shows what a real run would change.
          <a class="text-link" href="/docs/start/compatibility/">Check a project</a>
        </p>
      </div>
      <figure class="panel reveal refusal">
        <pre class="code core"><span class="c">$</span> volant playbook -i inventory.ini site.yml
<span class="err">ERROR! play 1: strategy 'mitogen_free' is not supported yet</span></pre>
        <figcaption>Real output of Volant 0.1.0-alpha.10, for a play that asks for a strategy this release does not have.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <dl class="files runtime">
          <div><dt>What it fetches</dt><dd>its own Python and ansible-core, about 155 MB, the first time a playbook needs Python</dd></div>
          <div><dt>How it checks it</dt><dd>every file against a hash pinned in the release</dd></div>
          <div><dt>Where it keeps it</dt><dd><code>~/.local/share/volant/runtime</code>, apart from any system Python</dd></div>
          <div><dt>Collections</dt><dd><code>volant runtime install --collections community.general</code></dd></div>
          <div><dt>Without a network</dt><dd><code>volant runtime pack</code> on one machine, <code>install --from</code> on the other</dd></div>
        </dl>
      </div>
      <div class="section-head reveal">
        <h2>No Ansible to install.</h2>
        <p>
          The binary carries the agents it uploads to your hosts. When a playbook needs a Python module, Volant installs a
          runtime of its own and keeps it apart from the rest of the machine.
        </p>
        <p><a class="text-link" href="/docs/reference/runtime/">The managed runtime</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="proof reveal">
        <a class="proof-card panel" href="/performance/">
          <div class="core">
            <b class="mono">{Math.round(ratio(fastest))}×</b>
            <span>faster on {fastest.name.toLowerCase()}, measured against ansible-core with pipelining</span>
            <em>Performance</em>
          </div>
        </a>
        <a class="proof-card panel" href="/compatibility/">
          <div class="core">
            <b class="mono">{coreShare}%</b>
            <span>of ansible-core’s {total(core)} keywords, options and plugins run today</span>
            <em>Compatibility</em>
          </div>
        </a>
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <h2>From the blog.</h2>
          </div>
          <ul class="posts reveal">
            {latest.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <time class="mono" datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
                  <b>{post.data.title}</b>
                  <span>{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="note"><a class="text-link" href="/blog/">Every post</a></p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>What Volant promises.</h2>
      </div>
      <div class="promises reveal">
        {
          promises.map(([title, text]) => (
            <div class="promise">
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap closing-row reveal">
      <div>
        <h2>Built in the open.</h2>
        <p>
          Volant is GPL-3.0-or-later, like Ansible. The roadmap, the issues and the decisions behind the design are
          public.
        </p>
      </div>
      <div class="ctas">
        <a class="btn btn-brand" href="/community/">Get involved</a>
        <a class="btn btn-line" href="/docs/project/roadmap/">Roadmap</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(30% 50% at 72% 48%, color-mix(in srgb, var(--brand) 9%, transparent), transparent 70%),
      radial-gradient(45% 55% at 0% 0%, color-mix(in srgb, var(--brand) 8%, transparent), transparent 70%);
  }
  .hero :global(.ascii-wheel) {
    position: absolute;
    inset: -6% -12% -6% 38%;
    opacity: 0.95;
    mask-image: radial-gradient(closest-side, #000 70%, transparent);
  }
  .hero-grid {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 7.5rem);
  }
  .hero-text {
    max-width: 46rem;
  }
  h1 {
    font-size: clamp(2.5rem, 5.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    font-weight: 650;
  }
  .lede {
    margin-top: 1.4rem;
    max-width: 34rem;
    color: var(--fg-2);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
  }
  .install {
    margin-top: 2rem;
    max-width: 32rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .platforms {
    margin-top: 0.6rem;
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .status {
    max-width: 36rem;
    margin-top: 2rem;
    color: var(--fg-2);
    font-size: 0.9rem;
  }
  .badge {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--state-changed) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--state-changed) 45%, transparent);
    color: var(--state-changed);
    font-size: 0.75rem;
    margin-inline-end: 0.4rem;
  }
  .console-wrap {
    margin-top: 2.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .split .section-head p + p {
    margin-top: 1.25rem;
  }

  .lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }
  .lane-card .core {
    padding: 1.5rem;
  }
  .lane-title {
    font-weight: 600;
  }
  .lane-title span {
    margin-inline-start: 0.4rem;
    color: var(--fg-3);
    font-weight: 400;
    font-size: 0.875rem;
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.9rem 0 1.4rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps:last-child {
    margin-bottom: 0;
  }
  .steps li {
    position: relative;
    padding: 0.45rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--fg-2);
    font: 0.8rem var(--f-mono);
  }
  .fast li,
  .once li {
    background: var(--brand-low);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 45%, transparent);
    color: var(--fg);
  }
  .once li {
    background: transparent;
    box-shadow: none;
    border: 1px dashed color-mix(in srgb, var(--brand) 45%, transparent);
  }
  /* A pulse walks the steps of each lane, the slow one at the pace of a task, again and again. */
  @media (prefers-reduced-motion: no-preference) {
    .steps li::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px var(--brand);
      opacity: 0;
      animation: walk var(--cycle) linear infinite;
      animation-delay: calc(var(--i) * var(--cycle) / var(--n));
    }
    .slow {
      --cycle: 5s;
      --n: 5;
    }
    .fast {
      --cycle: 1s;
      --n: 2;
    }
    .once li::after {
      display: none;
    }
    .slow li:nth-child(1),
    .fast li:nth-child(1) {
      --i: 0;
    }
    .slow li:nth-child(2),
    .fast li:nth-child(2) {
      --i: 1;
    }
    .slow li:nth-child(3) {
      --i: 2;
    }
    .slow li:nth-child(4) {
      --i: 3;
    }
    .slow li:nth-child(5) {
      --i: 4;
    }
  }
  @keyframes walk {
    0% {
      opacity: 1;
    }
    18% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  .note {
    margin-top: 1.5rem;
    max-width: 70ch;
    color: var(--fg-3);
    font-size: 0.95rem;
  }

  .files {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
  }
  .files div {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.925rem;
  }
  .files dt {
    color: var(--fg);
    font-weight: 560;
  }
  .files dd {
    margin: 0;
    color: var(--fg-3);
  }

  .refusal {
    margin: 0;
  }
  .refusal pre {
    white-space: pre-wrap;
  }
  .refusal .err {
    color: var(--state-failed);
  }
  .refusal figcaption {
    padding: 0.75rem 0.6rem 0.4rem;
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .runtime {
    margin: 0;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .proof-card {
    transition: border-color 0.3s var(--ease);
  }
  .proof-card:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, transparent);
  }
  .proof-card .core {
    display: grid;
    gap: 0.5rem;
    padding: 1.75rem;
  }
  .proof-card b {
    color: var(--brand-hi);
    font-size: clamp(2.4rem, 4.5vw, 3.2rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .proof-card span {
    color: var(--fg-2);
  }
  .proof-card em {
    margin-top: 0.5rem;
    color: var(--brand-hi);
    font-style: normal;
    font-weight: 560;
  }
  .posts {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .posts a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .posts time {
    grid-row: span 2;
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .posts b {
    font-weight: 600;
    transition: color 0.2s var(--ease);
  }
  .posts a:hover b {
    color: var(--brand-hi);
  }
  .posts span {
    color: var(--fg-2);
  }
  .promises {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 2.5rem;
  }
  .promise {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .promise h3 {
    font-size: 1.15rem;
  }
  .promise p {
    margin-top: 0.5rem;
    color: var(--fg-2);
  }

  .closing {
    background: radial-gradient(60% 80% at 85% 100%, color-mix(in srgb, var(--brand) 10%, transparent), transparent);
  }
  .closing-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .closing h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
  }
  .closing p {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: var(--fg-2);
  }

  @media (max-width: 60rem) {
    .split,
    .lanes,
    .promises {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof {
      grid-template-columns: minmax(0, 1fr);
    }
    .posts a {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero :global(.ascii-wheel) {
      inset: 30% -40% -20% 10%;
      opacity: 0.3;
    }
  }
  @media (max-width: 36rem) {
    .files div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
