$ ansible-inventory -i hosts.ini --list --yaml
all:
  children:
    prod:
      children:
        db:
          hosts:
            d1:
              ansible_host: 10.0.0.3
              backup: 'true'
              env: prod
              ports:
              - 80
              - 443
        web:
          hosts:
            w1:
              ansible_host: 10.0.0.1
              env: prod
              http_port: 8080
              ports: &id001
              - 80
              - 443
            w2:
              ansible_host: 10.0.0.2
              env: prod
              ports: *id001
